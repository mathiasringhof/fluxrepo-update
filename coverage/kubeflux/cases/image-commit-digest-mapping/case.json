{
  "id": "image-commit-digest-mapping",
  "category": "image-boundaries",
  "description": "A raw 40-hex commit plus digest in a repository/tag mapping remains pinned and precisely reported.",
  "audit": [
    "U5",
    "T2"
  ],
  "source": [
    "apps/production/ente-auth/release-patch.yaml"
  ],
  "expectation": "pass",
  "todo": "",
  "command": "apply",
  "responses": {},
  "checks": {
    "exit_code": 0,
    "json": [
      {
        "at": "/summary/discovered_count",
        "equals": 1
      },
      {
        "at": "/summary/checked_count",
        "equals": 0
      },
      {
        "at": "/summary/unchecked_count",
        "equals": 1
      },
      {
        "at": "/summary/planned_count",
        "equals": 0
      },
      {
        "at": "/summary/applied_count",
        "equals": 0
      },
      {
        "at": "/skipped",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.museum.image.tag",
          "current_value": "0123456789abcdef0123456789abcdef01234567@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "reason_code": "image_reference_pinned_by_digest",
          "retryable": false
        }
      }
    ]
  }
}
