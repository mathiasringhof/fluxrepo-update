{
  "id": "cnpg-image-update",
  "category": "custom-resource-images",
  "description": "Select an extension 0.4 patch within PostgreSQL major 16; preserve unrelated Cluster API groups.",
  "audit": [
    "U3"
  ],
  "source": [
    "apps/production/immich/cloudnative-pg.yaml"
  ],
  "expectation": "todo",
  "todo": "CNPG imageName lacks resolution/editing. This proposed selection policy stays within PostgreSQL major 16 and extension 0.4; PostgreSQL patch upgrade selection is not specified here.",
  "command": "apply",
  "responses": {
    "/v2/demo/postgres/tags/list": {
      "json": {
        "name": "demo/postgres",
        "tags": [
          "16.9-0.4.3",
          "16.9-0.4.4",
          "16.9-0.5.0",
          "17.1-0.4.9"
        ]
      }
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/applied_count",
        "equals": 1
      },
      {
        "at": "/planned",
        "contains": {
          "path": "database.yaml",
          "document_index": 0,
          "yaml_path": "spec.imageName",
          "current_version": "16.9-0.4.3",
          "latest_version": "16.9-0.4.4"
        }
      }
    ],
    "invariants": [
      {
        "at": "/summary/discovered_count",
        "equals": 1
      }
    ]
  }
}
