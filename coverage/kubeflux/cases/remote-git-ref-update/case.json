{
  "id": "remote-git-ref-update",
  "category": "remote-kustomize",
  "description": "Three coordinated Git refs advance to one release while retaining each selected subdirectory and local/commented resources.",
  "audit": [
    "U4"
  ],
  "source": [
    "infrastructure/base/intel-gpu/kustomization.yaml"
  ],
  "expectation": "todo",
  "todo": "HTTPS Kustomize refs have no upstream version resolver or writer.",
  "command": "apply",
  "responses": {
    "/repos/example/plugins/releases/latest": {
      "json": {
        "tag_name": "v2.0.0",
        "prerelease": false,
        "draft": false
      }
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/applied_count",
        "equals": 3
      },
      {
        "at": "/planned",
        "contains": {
          "path": "kustomization.yaml",
          "document_index": 0,
          "yaml_path": "resources[0]",
          "current_version": "v1.0.0",
          "latest_version": "v2.0.0"
        }
      },
      {
        "at": "/planned",
        "contains": {
          "path": "kustomization.yaml",
          "document_index": 0,
          "yaml_path": "resources[1]",
          "current_version": "v1.0.0",
          "latest_version": "v2.0.0"
        }
      },
      {
        "at": "/planned",
        "contains": {
          "path": "kustomization.yaml",
          "document_index": 0,
          "yaml_path": "resources[2]",
          "current_version": "v1.0.0",
          "latest_version": "v2.0.0"
        }
      }
    ],
    "invariants": [
      {
        "at": "/summary/discovered_count",
        "equals": 3
      }
    ]
  }
}
