{
  "id": "remote-git-ref-update",
  "category": "remote-kustomize",
  "description": "Three coordinated Git refs advance to one release while retaining each selected subdirectory and local/commented resources.",
  "audit": [
    "U4"
  ],
  "source": [
    "infrastructure/base/intel-gpu/kustomization.yaml"
  ],
  "expectation": "pass",
  "command": "apply",
  "responses": {
    "/repos/example/plugins/releases": {
      "json": [
        {
          "tag_name": "v2.0.0",
          "draft": false,
          "prerelease": false,
          "assets": []
        },
        {
          "tag_name": "v1.0.0",
          "draft": false,
          "prerelease": false,
          "assets": []
        }
      ]
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/applied_count",
        "equals": 1
      },
      {
        "at": "/summary/planned_count",
        "equals": 1
      },
      {
        "at": "/summary/checked_count",
        "equals": 3
      },
      {
        "at": "/summary/unchecked_count",
        "equals": 0
      },
      {
        "at": "/planned",
        "contains": {
          "path": "kustomization.yaml",
          "document_index": 0,
          "target_kind": "RemoteResource",
          "current_version": "v1.0.0",
          "latest_version": "v2.0.0"
        }
      },
      {
        "at": "/planned/0/resource_changes",
        "contains": {
          "document_index": 0,
          "yaml_path": "resources[0]",
          "current_resource": "https://github.com/example/plugins/deployments/nfd?ref=v1.0.0",
          "latest_resource": "https://github.com/example/plugins/deployments/nfd?ref=v2.0.0"
        }
      },
      {
        "at": "/planned/0/resource_changes",
        "contains": {
          "document_index": 0,
          "yaml_path": "resources[1]",
          "current_resource": "https://github.com/example/plugins/deployments/nfd/overlays/node-feature-rules?ref=v1.0.0",
          "latest_resource": "https://github.com/example/plugins/deployments/nfd/overlays/node-feature-rules?ref=v2.0.0"
        }
      },
      {
        "at": "/planned/0/resource_changes",
        "contains": {
          "document_index": 0,
          "yaml_path": "resources[2]",
          "current_resource": "https://github.com/example/plugins/deployments/gpu_plugin/overlays/nfd_labeled_nodes?ref=v1.0.0",
          "latest_resource": "https://github.com/example/plugins/deployments/gpu_plugin/overlays/nfd_labeled_nodes?ref=v2.0.0"
        }
      }
    ],
    "invariants": [
      {
        "at": "/summary/discovered_count",
        "equals": 3
      }
    ]
  }
}
