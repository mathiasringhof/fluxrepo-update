{
  "id": "scope-exclusions",
  "category": "scope",
  "description": "Eligible inactive .yml manifests update independently of the Kustomize graph; hidden directories, build caches, and non-YAML files remain byte-identical.",
  "audit": [
    "T4"
  ],
  "source": [
    "apps/base/uptimekuma/release.yaml"
  ],
  "expectation": "pass",
  "todo": "",
  "command": "apply",
  "responses": {
    "/v2/demo/app/tags/list": {
      "json": {
        "tags": [
          "1.0.0",
          "2.0.0"
        ]
      }
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/discovered_count",
        "equals": 1
      },
      {
        "at": "/summary/checked_count",
        "equals": 1
      },
      {
        "at": "/summary/unchecked_count",
        "equals": 0
      },
      {
        "at": "/summary/planned_count",
        "equals": 1
      },
      {
        "at": "/summary/applied_count",
        "equals": 1
      },
      {
        "at": "/planned",
        "contains": {
          "path": "apps/inactive/pod.yml",
          "document_index": 0,
          "yaml_path": "spec.containers[0].image",
          "current_version": "1.0.0",
          "latest_version": "2.0.0"
        }
      },
      {
        "at": "/summary/changed_file_count",
        "equals": 1
      }
    ]
  }
}
