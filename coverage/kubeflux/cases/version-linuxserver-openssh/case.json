{
  "id": "version-linuxserver-openssh",
  "category": "version-families",
  "description": "LinuxServer OpenSSH selection compares the base version, _p component, and -r component numerically while preserving published spelling.",
  "audit": [
    "T3"
  ],
  "source": [
    "apps/production/openssh/deployment.yaml"
  ],
  "expectation": "pass",
  "todo": "",
  "command": "apply",
  "responses": {
    "/v2/demo/app/tags/list": {
      "json": {
        "tags": [
          "version-10.3_p1-r0",
          "version-10.3_p1-r10",
          "version-10.4_p1-r0",
          "10.5.0",
          "latest"
        ]
      }
    },
    "/v2/demo/patch/tags/list": {
      "json": {
        "tags": [
          "version-10.3_p2-r0",
          "version-10.3_p9-r20",
          "version-10.3_p10-r0"
        ]
      }
    },
    "/v2/demo/revision/tags/list": {
      "json": {
        "tags": [
          "version-10.3_p1-r2",
          "version-10.3_p1-r9",
          "version-10.3_p1-r10"
        ]
      }
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/discovered_count",
        "equals": 3
      },
      {
        "at": "/summary/checked_count",
        "equals": 3
      },
      {
        "at": "/summary/unchecked_count",
        "equals": 0
      },
      {
        "at": "/summary/planned_count",
        "equals": 3
      },
      {
        "at": "/summary/applied_count",
        "equals": 3
      },
      {
        "at": "/planned",
        "contains": {
          "path": "pod.yaml",
          "document_index": 0,
          "yaml_path": "spec.containers[0].image",
          "current_version": "version-10.3_p1-r0",
          "latest_version": "version-10.4_p1-r0",
          "latest_image": "{{registry}}/demo/app:version-10.4_p1-r0"
        }
      },
      {
        "at": "/planned",
        "contains": {
          "path": "pod.yaml",
          "document_index": 0,
          "yaml_path": "spec.containers[1].image",
          "current_version": "version-10.3_p2-r0",
          "latest_version": "version-10.3_p10-r0",
          "latest_image": "{{registry}}/demo/patch:version-10.3_p10-r0"
        }
      },
      {
        "at": "/planned",
        "contains": {
          "path": "pod.yaml",
          "document_index": 0,
          "yaml_path": "spec.containers[2].image",
          "current_version": "version-10.3_p1-r2",
          "latest_version": "version-10.3_p1-r10",
          "latest_image": "{{registry}}/demo/revision:version-10.3_p1-r10"
        }
      }
    ]
  }
}
