{
  "id": "yaml-indentless-helm-values-lists",
  "category": "yaml-editing",
  "description": "Apply every image in valid indentless block-sequence siblings, preserving the original YAML style and all unrelated fields.",
  "audit": [
    "U15"
  ],
  "source": [
    "apps/production/jellyfin/release.yaml",
    "infrastructure/production/nginx/nginx-values.yaml"
  ],
  "expectation": "todo",
  "todo": "The scanner finds these valid YAML declarations, but the YAML edit layer currently loses an indentless sibling list and aborts with a missing YAML path. Both selected version changes must apply without changing list indentation.",
  "command": "apply",
  "responses": {
    "/v2/demo/init/tags/list": {
      "json": {
        "tags": [
          "1.0.0",
          "2.0.0"
        ]
      }
    },
    "/v2/demo/helper/tags/list": {
      "json": {
        "tags": [
          "1.0.0",
          "2.0.0"
        ]
      }
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/discovered_count",
        "equals": 4
      },
      {
        "at": "/summary/checked_count",
        "equals": 2
      },
      {
        "at": "/summary/unchecked_count",
        "equals": 2
      },
      {
        "at": "/summary/planned_count",
        "equals": 2
      },
      {
        "at": "/summary/applied_count",
        "equals": 2
      },
      {
        "at": "/planned",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.initContainers[0].image",
          "current_version": "1.0.0",
          "latest_version": "2.0.0"
        }
      },
      {
        "at": "/planned",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.extraContainers[0].image.tag",
          "current_version": "1.0.0",
          "latest_version": "2.0.0"
        }
      },
      {
        "at": "/skipped",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.initContainers[1].image",
          "current_value": "{{registry}}/demo/tagless",
          "reason_code": "image_reference_missing_tag",
          "retryable": false
        }
      },
      {
        "at": "/skipped",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.extraContainers[1].image",
          "current_value": "{{registry}}/demo/sidecar:latest",
          "reason_code": "mutable_image_tag",
          "retryable": false
        }
      }
    ]
  },
  "known_failure": {
    "exit_code": 2,
    "error": "runtime_error",
    "message_contains": "missing YAML path spec.values.extraContainers[0].image.tag"
  }
}
