{
  "id": "negative-controls",
  "category": "scope",
  "description": "SOPS/schema/API versions, configuration rollout revisions, arbitrary numbers, comments, and ordinary disk paths remain unchanged beside one real image update.",
  "audit": [
    "T4"
  ],
  "source": [
    "apps/base/sonarr/secret.yaml",
    "apps/production/paperless-ngx/release-patch.yaml",
    "kubevirt/testing/debian-vm/debian.yaml"
  ],
  "expectation": "pass",
  "todo": "",
  "command": "apply",
  "responses": {
    "/v2/demo/app/tags/list": {
      "json": {
        "tags": [
          "1.0.0",
          "2.0.0"
        ]
      }
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/discovered_count",
        "equals": 1
      },
      {
        "at": "/summary/checked_count",
        "equals": 1
      },
      {
        "at": "/summary/unchecked_count",
        "equals": 0
      },
      {
        "at": "/summary/planned_count",
        "equals": 1
      },
      {
        "at": "/summary/applied_count",
        "equals": 1
      },
      {
        "at": "/planned",
        "contains": {
          "path": "pod.yaml",
          "document_index": 0,
          "yaml_path": "spec.containers[0].image",
          "current_version": "1.0.0",
          "latest_version": "2.0.0"
        }
      },
      {
        "at": "/summary/changed_file_count",
        "equals": 1
      }
    ]
  }
}
