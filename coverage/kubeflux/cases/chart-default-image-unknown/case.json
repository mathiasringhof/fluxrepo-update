{
  "id": "chart-default-image-unknown",
  "category": "inherited-identity",
  "description": "An image override without an available chart default stays visible and unchanged.",
  "audit": [
    "U2"
  ],
  "source": [
    "apps/base/immich/release.yaml",
    "infrastructure/production/openebs/release.yaml"
  ],
  "expectation": "pass",
  "todo": "",
  "command": "apply",
  "responses": {},
  "checks": {
    "exit_code": 0,
    "json": [
      {
        "at": "/summary/unchecked_count",
        "equals": 1
      },
      {
        "at": "/summary/applied_count",
        "equals": 0
      },
      {
        "at": "/skipped",
        "contains": {
          "path": "release.yaml",
          "yaml_path": "spec.values.image.tag",
          "current_value": "v3.1.0"
        }
      }
    ]
  }
}
