{
  "id": "helm-values-lists",
  "category": "helm-values",
  "description": "Apply scalar and mapping images in Helm values lists while preserving neighboring tagless and mutable images.",
  "audit": [
    "T1"
  ],
  "source": [
    "apps/production/jellyfin/release.yaml",
    "infrastructure/production/nginx/nginx-values.yaml"
  ],
  "expectation": "pass",
  "todo": "",
  "command": "apply",
  "responses": {
    "/v2/demo/init/tags/list": {
      "json": {
        "tags": [
          "1.0.0",
          "2.0.0"
        ]
      }
    },
    "/v2/demo/helper/tags/list": {
      "json": {
        "tags": [
          "1.0.0",
          "2.0.0"
        ]
      }
    }
  },
  "checks": {
    "exit_code": 20,
    "json": [
      {
        "at": "/summary/discovered_count",
        "equals": 4
      },
      {
        "at": "/summary/checked_count",
        "equals": 2
      },
      {
        "at": "/summary/unchecked_count",
        "equals": 2
      },
      {
        "at": "/summary/planned_count",
        "equals": 2
      },
      {
        "at": "/summary/applied_count",
        "equals": 2
      },
      {
        "at": "/planned",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.initContainers[0].image",
          "current_version": "1.0.0",
          "latest_version": "2.0.0"
        }
      },
      {
        "at": "/planned",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.extraContainers[0].image.tag",
          "current_version": "1.0.0",
          "latest_version": "2.0.0"
        }
      },
      {
        "at": "/skipped",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.initContainers[1].image",
          "current_value": "{{registry}}/demo/tagless",
          "reason_code": "image_reference_missing_tag",
          "retryable": false
        }
      },
      {
        "at": "/skipped",
        "contains": {
          "path": "release.yaml",
          "document_index": 0,
          "yaml_path": "spec.values.extraContainers[1].image",
          "current_value": "{{registry}}/demo/sidecar:latest",
          "reason_code": "mutable_image_tag",
          "retryable": false
        }
      }
    ]
  }
}
